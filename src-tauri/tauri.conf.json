{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buffers",
  "version": "0.1.0",
  "identifier": "com.trencseni.buffers",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "security unlock-keychain -p '' ~/Library/Keychains/delight-signing.keychain-db 2>/dev/null; pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Buffers",
        "width": 1000,
        "height": 700,
        "minWidth": 520,
        "minHeight": 360,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Delight Self Signed"
    }
  }
}
