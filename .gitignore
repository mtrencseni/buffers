# Dependencies and build output — regenerated by `pnpm install` / `pnpm tauri build`.
node_modules/
dist/
# The web UI's build (`pnpm build:web`), and the copy the server serves.
dist-web/

# Rust / Tauri build artifacts. src-tauri/gen holds generated schemas.
src-tauri/target/
src-tauri/gen/

# Server: virtualenv, the shared secret, the pushed buffers, and the served UI.
__pycache__/
server/.venv/
server/.env
server/data/
server/web/

# OS cruft (both platforms, so neither has to see the other's).
.DS_Store
Thumbs.db
desktop.ini
